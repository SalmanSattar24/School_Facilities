# Copy this file to secrets.local.env or run:
#   .\.venv\Scripts\school-facilities.exe save-gemini-key
#
# secrets.local.env is ignored by Git. It contains a plain-text secret: never
# commit it, attach it, or include it in a submission archive.
GEMINI_API_KEY=

# Optional V1.11 supplemental Street View key. Restrict this key to the
# Static Street View API before any live image request.
GOOGLE_STREET_VIEW_API_KEY=
